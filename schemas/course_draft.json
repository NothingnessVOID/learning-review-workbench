{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "course_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[\\w.-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "series": {
      "type": "string",
      "maxLength": 200
    },
    "course_date": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 40
        },
        {
          "type": "null"
        }
      ]
    },
    "overview": {
      "type": "string",
      "maxLength": 50000
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source_version_ids": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[\\w.-]+$"
      }
    },
    "topics": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[\\w.-]+$"
          },
          "course_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[\\w.-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "parent_id": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[\\w.-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "content_kind": {
            "type": "string",
            "maxLength": 60
          },
          "blocks": {
            "maxItems": 300,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[\\w.-]+$"
                },
                "type": {
                  "type": "string",
                  "maxLength": 60
                },
                "body_md": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300000
                },
                "origin_kind": {
                  "type": "string",
                  "maxLength": 80
                },
                "transformation": {
                  "type": "string",
                  "maxLength": 80
                },
                "source_refs": {
                  "maxItems": 500,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source_document_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160,
                        "pattern": "^[\\w.-]+$"
                      },
                      "source_version_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160,
                        "pattern": "^[\\w.-]+$"
                      },
                      "source_block_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160,
                        "pattern": "^[\\w.-]+$"
                      }
                    },
                    "required": [
                      "source_document_id",
                      "source_version_id",
                      "source_block_id"
                    ],
                    "additionalProperties": false
                  }
                },
                "verification_status": {
                  "default": "needs_review",
                  "type": "string",
                  "maxLength": 80
                }
              },
              "required": [
                "type",
                "body_md",
                "origin_kind",
                "transformation",
                "source_refs",
                "verification_status"
              ],
              "additionalProperties": false
            }
          },
          "revision": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "title",
          "parent_id",
          "order",
          "content_kind",
          "blocks"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "minItems": 1,
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_block_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[\\w.-]+$"
          },
          "disposition": {
            "type": "string",
            "maxLength": 80
          },
          "topic_ids": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[\\w.-]+$"
            }
          }
        },
        "required": [
          "source_block_id",
          "disposition",
          "topic_ids"
        ],
        "additionalProperties": false
      }
    },
    "knowledge_candidates": {
      "default": [],
      "maxItems": 500,
      "type": "array",
      "items": {}
    },
    "unresolved_questions": {
      "default": [],
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "authorship": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "maxLength": 80
        },
        "name": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    "client_request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[\\w.-]+$"
    }
  },
  "required": [
    "overview",
    "expected_revision",
    "source_version_ids",
    "topics",
    "coverage",
    "knowledge_candidates",
    "unresolved_questions",
    "client_request_id"
  ],
  "additionalProperties": false
}
