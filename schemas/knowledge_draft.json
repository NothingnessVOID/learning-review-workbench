{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "card_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[\\w.-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "original_name": {
      "type": "string",
      "maxLength": 500
    },
    "type": {
      "default": "concept",
      "type": "string",
      "enum": [
        "model",
        "concept",
        "viewpoint",
        "method"
      ]
    },
    "original_type": {
      "type": "string",
      "maxLength": 100
    },
    "aliases": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "body_md": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300000
    },
    "source_refs": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_document_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[\\w.-]+$"
          },
          "source_version_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[\\w.-]+$"
          },
          "source_block_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[\\w.-]+$"
          }
        },
        "required": [
          "source_document_id",
          "source_version_id",
          "source_block_id"
        ],
        "additionalProperties": false
      }
    },
    "topic_ids": {
      "default": [],
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[\\w.-]+$"
      }
    },
    "verification_status": {
      "default": "needs_review",
      "type": "string",
      "maxLength": 80
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "client_request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[\\w.-]+$"
    }
  },
  "required": [
    "title",
    "type",
    "aliases",
    "body_md",
    "source_refs",
    "topic_ids",
    "verification_status",
    "expected_revision",
    "client_request_id"
  ],
  "additionalProperties": false
}
