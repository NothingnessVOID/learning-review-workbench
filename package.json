{
  "name": "learning-workbench",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild src/server/index.ts --outfile=dist/index.js --platform=node --format=esm --packages=external --bundle && esbuild src/mcp/stdio.ts --outfile=dist/stdio.js --platform=node --format=esm --packages=external --bundle && node scripts/build-info.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "postinstall": "node scripts/build-info.mjs --dependencies",
    "test:e2e": "node scripts/e2e.mjs",
    "test:http": "node scripts/http-regression.mjs",
    "test:habit-mcp": "node scripts/habit-mcp-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "adm-zip": "0.6.1",
    "express": "5.2.1",
    "opencc-js": "1.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/adm-zip": "0.5.8",
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
